    },
    {
      "id": "ff9ee1ef8231dbb0",
      "fromNode": "e15cc8c33072f150",
      "toNode": "e4d6a2e5c342d1bf",
      "fromSide": "bottom",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "si ordinano per esempio con"
    },
    {
      "id": "20e1fef0f8e75b85",
      "fromNode": "e4d6a2e5c342d1bf",
      "toNode": "1ea485f0a4376e2e",
      "fromSide": "bottom",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "può soffrire di"
    },
